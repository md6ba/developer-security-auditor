{
  "schema_version": "1.0.0",
  "catalog_version": "1.0.0",
  "description": "Developer Security Auditor rule catalog. Rules are deterministic, evidence-bearing, and language-aware. Patterns are applied to working trees and to git history.",
  "rules": [
    {
      "id": "SEC-ENV-001",
      "title": "Committed environment file",
      "category": "secret_exposure",
      "severity": "HIGH",
      "confidence": "CONFIRMED",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["*"],
      "paths": [".env", ".env.*"],
      "exclude_paths": [".env.example", ".env.sample", ".env.template", ".env.*.example"],
      "pattern": null,
      "note": "Any tracked .env that is not an example template. Content must be inspected for populated values.",
      "remediation": "Remove the file, add it to .gitignore, rotate anything that was in it."
    },
    {
      "id": "SEC-SEC-001",
      "title": "Hardcoded password assignment",
      "category": "secret_exposure",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["python", "javascript", "typescript", "java", "go", "ruby", "php"],
      "pattern": "(?i)(password|passwd|pwd)\\s*[=:]\\s*['\"][^'\"]{3,}['\"]",
      "exclude": "(getenv|environ|os\\.environ|config\\(|process\\.env|\\$\\{|<|placeholder|example|your-|changeme|test)",
      "remediation": "Read the value from an environment variable or a secrets manager."
    },
    {
      "id": "SEC-SEC-002",
      "title": "Hardcoded API key assignment",
      "category": "secret_exposure",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["python", "javascript", "typescript", "java", "go", "ruby", "php"],
      "pattern": "(?i)(api[_-]?key|apikey|secret[_-]?key|access[_-]?key)\\s*[=:]\\s*['\"][A-Za-z0-9_/+.-]{12,}['\"]",
      "exclude": "(getenv|environ|os\\.environ|config\\(|process\\.env|\\$\\{|placeholder|example|your-|test)",
      "remediation": "Move the key to an environment variable or a secrets manager and rotate it."
    },
    {
      "id": "SEC-SEC-003",
      "title": "Private key committed",
      "category": "secret_exposure",
      "severity": "CRITICAL",
      "confidence": "CONFIRMED",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["*"],
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP |)PRIVATE KEY-----",
      "remediation": "Remove the key, add keys/ and *.pem to .gitignore, and rotate the key pair."
    },
    {
      "id": "SEC-SEC-004",
      "title": "Database connection string with credentials",
      "category": "secret_exposure",
      "severity": "CRITICAL",
      "confidence": "CONFIRMED",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["*"],
      "pattern": "(?i)(postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|amqp)://[^:\\s]+:[^@\\s]+@[^\\s/]+",
      "remediation": "Use a secrets manager or environment variable; never embed credentials in a URL."
    },
    {
      "id": "SEC-SEC-005",
      "title": "JWT signing secret hardcoded",
      "category": "secret_exposure",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["python", "javascript", "typescript", "java", "go"],
      "pattern": "(?i)(jwt[_-]?secret|jwt[_-]?key|signing[_-]?key)\\s*[=:]\\s*['\"][^'\"]{8,}['\"]",
      "exclude": "(getenv|environ|process\\.env|\\$\\{|placeholder|example|your-|django-insecure|test)",
      "remediation": "Load the signing secret from an environment variable and rotate it."
    },
    {
      "id": "SEC-SEC-006",
      "title": "Telegram bot token",
      "category": "secret_exposure",
      "severity": "HIGH",
      "confidence": "CONFIRMED",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["*"],
      "pattern": "\\b[0-9]{8,10}:[A-Za-z0-9_-]{30,}\\b",
      "remediation": "Revoke the token through the bot API owner and issue a new one."
    },
    {
      "id": "SEC-SEC-007",
      "title": "Cloud provider access key",
      "category": "secret_exposure",
      "severity": "CRITICAL",
      "confidence": "CONFIRMED",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["*"],
      "pattern": "\\b(AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})\\b",
      "remediation": "Rotate the key immediately and move it to a secrets manager."
    },
    {
      "id": "SEC-SEC-008",
      "title": "EVM private key",
      "category": "secret_exposure",
      "severity": "CRITICAL",
      "confidence": "CONFIRMED",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["*"],
      "pattern": "\\b0x[a-fA-F0-9]{64}\\b",
      "remediation": "Treat the wallet as compromised: move funds, abandon the key, rotate."
    },
    {
      "id": "SEC-SEC-009",
      "title": "Mnemonic or seed phrase",
      "category": "secret_exposure",
      "severity": "CRITICAL",
      "confidence": "PROBABLE",
      "cwe": "CWE-798",
      "owasp": "A07:2021",
      "languages": ["*"],
      "pattern": "\\b((?:[a-z]{3,12}\\s){11,23}[a-z]{3,12})\\b",
      "exclude": "(^the\\s|^a\\s|^this\\s|^in\\s|^to\\s)",
      "note": "High false-positive rate. Always verify in context before reporting.",
      "remediation": "Move the wallet to a new seed and never store the phrase in a repository."
    },
    {
      "id": "SEC-CFG-001",
      "title": "Debug mode enabled",
      "category": "configuration",
      "severity": "MEDIUM",
      "confidence": "PROBABLE",
      "cwe": "CWE-489",
      "owasp": "A05:2021",
      "languages": ["python", "javascript", "typescript"],
      "pattern": "(?i)(debug\\s*=\\s*true|DEBUG\\s*=\\s*['\"]?true|debug:\\s*true|node_env\\s*=\\s*['\"]development)",
      "remediation": "Disable debug mode in production builds and deployments."
    },
    {
      "id": "SEC-CFG-002",
      "title": "TLS certificate verification disabled",
      "category": "configuration",
      "severity": "HIGH",
      "confidence": "CONFIRMED",
      "cwe": "CWE-295",
      "owasp": "A07:2021",
      "languages": ["python", "javascript", "typescript", "go", "ruby"],
      "pattern": "(?i)(verify_ssl\\s*=\\s*false|rejectUnauthorized\\s*:\\s*false|verify\\s*:\\s*false|InsecureSkipVerify\\s*:\\s*true|curl.*-k\\b)",
      "remediation": "Enable certificate verification; use a proper CA bundle instead."
    },
    {
      "id": "SEC-CFG-003",
      "title": "CORS allow-all",
      "category": "configuration",
      "severity": "MEDIUM",
      "confidence": "PROBABLE",
      "cwe": "CWE-942",
      "owasp": "A05:2021",
      "languages": ["python", "javascript", "typescript", "java", "go"],
      "pattern": "(?i)(Access-Control-Allow-Origin\\s*:\\s*\\*|cors\\(\\s*['\"]\\*|allow_origins\\s*=\\s*\\['\"]\\*|origin\\s*:\\s*['\"]\\*)",
      "remediation": "Restrict allowed origins to the actual set of trusted domains."
    },
    {
      "id": "SEC-CFG-004",
      "title": "Insecure file permissions",
      "category": "configuration",
      "severity": "MEDIUM",
      "confidence": "PROBABLE",
      "cwe": "CWE-732",
      "owasp": "A05:2021",
      "languages": ["python", "go", "ruby"],
      "pattern": "(?i)(chmod\\s+777|os\\.Chmod\\s*\\([^)]*0o777|FileMode\\s*:\\s*0777)",
      "remediation": "Use the least permissive mode that still works (typically 0600 for secrets)."
    },
    {
      "id": "SEC-CFG-005",
      "title": "Container runs as root",
      "category": "configuration",
      "severity": "MEDIUM",
      "confidence": "PROBABLE",
      "cwe": "CWE-250",
      "owasp": "A05:2021",
      "languages": ["*"],
      "paths": ["Dockerfile", "docker-compose*.yml", "*.dockerfile"],
      "pattern": "(?i)(USER\\s+root|runAsUser:\\s*0)",
      "remediation": "Add a non-root USER instruction and drop capabilities."
    },
    {
      "id": "SEC-CFG-006",
      "title": "Missing .gitignore in a repository with secrets",
      "category": "git_workflow",
      "severity": "MEDIUM",
      "confidence": "CONFIRMED",
      "cwe": "CWE-540",
      "owasp": "A05:2021",
      "languages": ["*"],
      "pattern": null,
      "note": "Checked at repository level: no .gitignore, or a .gitignore that omits .env, keys/, *.pem, *.key.",
      "remediation": "Add a .gitignore covering .env, keys/, *.pem, *.key, __pycache__/, .venv/, node_modules/."
    },
    {
      "id": "SEC-SRC-001",
      "title": "SQL built by string concatenation",
      "category": "code",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-89",
      "owasp": "A03:2021",
      "languages": ["python", "javascript", "typescript", "java", "php", "ruby"],
      "pattern": "(?i)(execute|cursor\\.execute|query|exec)\\s*\\(\\s*['\"][^'\" ]*['\"]\\s*\\+\\s*|f['\"].*\\b(SELECT|INSERT|UPDATE|DELETE|WHERE)\\b.*\\{",
      "remediation": "Use parameterised queries or an ORM; never concatenate input into SQL."
    },
    {
      "id": "SEC-SRC-002",
      "title": "Shell command built by interpolation",
      "category": "code",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-78",
      "owasp": "A03:2021",
      "languages": ["python", "javascript", "typescript", "php", "ruby", "go"],
      "pattern": "(?i)(os\\.system|subprocess\\.(call|run|Popen)\\s*\\(\\s*f['\"]|exec\\s*\\(\\s*f['\"]|child_process\\.(exec|execSync)\\s*\\(\\s*[`\"']\\s*(?:\\$|\\{))",
      "remediation": "Pass arguments as a list and never through a shell; validate against an allowlist."
    },
    {
      "id": "SEC-SRC-003",
      "title": "Path traversal via user input",
      "category": "code",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-22",
      "owasp": "A01:2021",
      "languages": ["python", "javascript", "typescript", "java", "php"],
      "pattern": "(?i)(open|readFile|readFileSync|sendFile|send_file|File\\.read)\\s*\\([^)]*(request\\.|req\\.|params|query|body|userInput)",
      "remediation": "Resolve the path and verify it stays inside the intended base directory."
    },
    {
      "id": "SEC-SRC-004",
      "title": "DOM XSS via innerHTML",
      "category": "code",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-79",
      "owasp": "A03:2021",
      "languages": ["javascript", "typescript"],
      "pattern": "(?i)(innerHTML|outerHTML|document\\.write|insertAdjacentHTML)\\s*[=(][^;]*(userInput|req\\.|request\\.|params|query|body|\\$\\{)",
      "remediation": "Use textContent or a templating engine that escapes by default."
    },
    {
      "id": "SEC-SRC-005",
      "title": "Insecure deserialization",
      "category": "code",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-502",
      "owasp": "A08:2021",
      "languages": ["python", "java", "php", "ruby"],
      "pattern": "(?i)(pickle\\.loads?|yaml\\.load\\s*\\(|unserialize\\s*\\(|Marshal\\.load|ObjectInputStream)",
      "remediation": "Use a safe format (JSON) or a strictly-validated parser; never deserialise untrusted data."
    },
    {
      "id": "SEC-SRC-006",
      "title": "Weak hash algorithm",
      "category": "code",
      "severity": "MEDIUM",
      "confidence": "CONFIRMED",
      "cwe": "CWE-327",
      "owasp": "A02:2021",
      "languages": ["python", "javascript", "typescript", "java", "go", "ruby", "php"],
      "pattern": "(?i)(md5|sha1|hashlib\\.md5|createHash\\(['\"]md5|MessageDigest\\.getInstance\\(['\"]MD5|Digest::MD5)",
      "exclude": "(checksum|integrity|fingerprint|etag)",
      "remediation": "Use SHA-256 or better; for password storage use argon2, bcrypt, or scrypt."
    },
    {
      "id": "SEC-SRC-007",
      "title": "Weak random for security purposes",
      "category": "code",
      "severity": "MEDIUM",
      "confidence": "PROBABLE",
      "cwe": "CWE-338",
      "owasp": "A02:2021",
      "languages": ["python", "javascript", "typescript", "java"],
      "pattern": "(?i)(Math\\.random|random\\.random\\s*\\(|new\\s+Random\\s*\\()",
      "exclude": "(test|mock|seed|chart|animation|render)",
      "note": "Only a finding when used for tokens, keys, or session identifiers. Verify context.",
      "remediation": "Use a cryptographically secure generator (secrets, crypto.getRandomValues, SecureRandom)."
    },
    {
      "id": "SEC-SRC-008",
      "title": "Server-side request forgery",
      "category": "code",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-918",
      "owasp": "A10:2021",
      "languages": ["python", "javascript", "typescript", "java", "php", "ruby"],
      "pattern": "(?i)(requests\\.(get|post)\\s*\\(\\s*(request\\.|req\\.|params|query|body)|fetch\\s*\\(\\s*(req\\.|request\\.|params|query|body)|URI\\.open\\s*\\(\\s*request)",
      "remediation": "Validate the URL against an allowlist of hosts and block internal address ranges."
    },
    {
      "id": "SEC-WEB3-001",
      "title": "Smart contract owner privilege concentration",
      "category": "web3",
      "severity": "MEDIUM",
      "confidence": "PROBABLE",
      "cwe": "CWE-269",
      "owasp": "A01:2021",
      "languages": ["solidity"],
      "pattern": "(?i)(onlyOwner|Ownable|owner\\s*=\\s*_?owner|setFeeRecipient|mint\\s*\\(\\s*_?owner)",
      "note": "Report as centralisation risk, not as a vulnerability. State the control and who holds it.",
      "remediation": "Use a timelock, a multisig, or renounce ownership after deployment."
    },
    {
      "id": "SEC-WEB3-002",
      "title": "Unchecked external call",
      "category": "web3",
      "severity": "HIGH",
      "confidence": "PROBABLE",
      "cwe": "CWE-841",
      "owasp": "A01:2021",
      "languages": ["solidity"],
      "pattern": "(?i)(\\.call\\{[^}]*\\}\\s*\\(|\\.send\\s*\\(|\\.transfer\\s*\\()",
      "exclude": "(require\\s*\\()",
      "note": "Check whether the return value is verified.",
      "remediation": "Check the return value, or use a reentrancy guard and checks-effects-interactions ordering."
    }
  ]
}
